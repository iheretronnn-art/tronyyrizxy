local function char(p) return p and p.Character end
local function hum(p) local c = char(p) return c and c:FindFirstChildOfClass("Humanoid") end
local function root(p) local c = char(p) return c and c:FindFirstChild("HumanoidRootPart") end

local function getRole(p)
	local bp, c = p and p:FindFirstChild("Backpack"), char(p)
	local has(n) return (bp and bp:FindFirstChild(n)) or (c and c:FindFirstChild(n)) end
	if has("Knife") then return "Murderer", Color3.fromRGB(235, 65, 65) end
	if has("Gun") or has("Revolver") then return "Sheriff", Color3.fromRGB(70, 150, 255) end
	local r = string.lower(tostring(p and p:GetAttribute("Role") or (c and c:GetAttribute("Role")) or ""))
	if r:find("murd") then return "Murderer", Color3.fromRGB(235, 65, 65) end
	if r:find("sher") or r:find("hero") then return "Sheriff", Color3.fromRGB(70, 150, 255) end
	return "Innocent", Color3.fromRGB(255, 230, 80)
end

local function setSky(id)
	local sky = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky", Lighting)
	for _, prop in ipairs({ "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }) do sky[prop] = id end
end

