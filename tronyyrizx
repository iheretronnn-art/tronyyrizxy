		S[keyName] = not S[keyName]
		b.Text = txt .. (S[keyName] and " : ON" or " : OFF")
		style(b, S[keyName] and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(20, 20, 20), S[keyName] and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255), 14)
		if onToggle then onToggle(S[keyName]) end
	end)
end

