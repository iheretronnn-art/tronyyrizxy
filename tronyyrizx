local function getMurderer()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and getRole(p) == "Murderer" then
			local h, r = hum(p), root(p)
			if h and h.Health > 0 and r then return (char(p) and char(p):FindFirstChild("Head")) or r end
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	local h, r = hum(LP), root(LP)

	if S.airSpeed and h then
		local air = h:GetState() == Enum.HumanoidStateType.Freefall or h:GetState() == Enum.HumanoidStateType.Jumping
		h.WalkSpeed = (air and h.MoveDirection.Magnitude > 0.05) and BST_SPD or DEF_SPD
	end

	if S.fly and r and h then
		local m = h.MoveDirection
		local y = (UIS:IsKeyDown(Enum.KeyCode.Space) and 1 or 0) - ((UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.C)) and 1 or 0)
		local dir = Vector3.new(m.X, y, m.Z)
		if dir.Magnitude > 0 then dir = dir.Unit end
		r.AssemblyLinearVelocity = dir * FLY_SPD + Vector3.new(0, 2.2, 0)
		h:ChangeState(Enum.HumanoidStateType.Running)
	end

	if S.antiKill and r then
		if h and h.Health > 0 and h.Health < h.MaxHealth then h.Health = h.MaxHealth end
		if not S.killAll then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LP and getRole(p) == "Murderer" and root(p) and (root(p).Position - r.Position).Magnitude < 5.5 then
					r.CFrame += (r.Position - root(p).Position).Unit * 2.5
				end
			end
		end
	end

	if S.killAll and r and char(LP) then
		kaTimer += dt
		if kaTimer >= 0.12 then
			kaTimer = 0
			local tool = char(LP):FindFirstChildOfClass("Tool") or (LP:FindFirstChild("Backpack") and LP.Backpack:FindFirstChild("Knife"))
			if tool and tool.Parent ~= char(LP) and h then h:EquipTool(tool) end
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LP and root(p) and hum(p) and hum(p).Health > 0 then
					r.CFrame = root(p).CFrame * CFrame.new(0, 0, 2)
					if tool then tool:Activate() end
					break
				end
			end
		end
	end

	if not S.esp then
		for p, g in pairs(espMap) do g:Destroy() espMap[p] = nil end
	else
		for _, p in ipairs(Players:GetPlayers()) do
			local head = p ~= LP and char(p) and char(p):FindFirstChild("Head")
			if head then
				local g = espMap[p]
				if not g then
					g = Instance.new("BillboardGui", gui)
					g.Adornee, g.Size, g.StudsOffset, g.AlwaysOnTop = head, UDim2.new(0, 140, 0, 30), Vector3.new(0, 2.5, 0), true
					local l = Instance.new("TextLabel", g)
					l.Name, l.Size, l.BackgroundColor3, l.BackgroundTransparency, l.BorderSizePixel = "L", UDim2.new(1, 0, 1, 0), Color3.fromRGB(0, 0, 0), 0.25, 0
					l.Font, l.TextSize = Enum.Font.GothamBold, 13
					espMap[p] = g
				end
				local role, col = getRole(p)
				g.L.Text, g.L.TextColor3 = p.Name .. " [" .. role .. "]", col
			elseif espMap[p] then
				espMap[p]:Destroy() espMap[p] = nil
			end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if not S.aimlock then return end
	local t = getMurderer()
	if not t then return end
	UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
	local r = root(LP)
	if r then r.CFrame = CFrame.lookAt(r.Position, Vector3.new(t.Position.X, r.Position.Y, t.Position.Z)) end
	Cam.CFrame = CFrame.lookAt(Cam.CFrame.Position, t.Position)
end)
